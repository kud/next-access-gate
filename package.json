{
  "name": "@kud/next-access-gate",
  "version": "0.1.0",
  "private": false,
  "description": "A password gate for Next.js demos and presentations: proxy, signed cookie and a minimal, customisable access page",
  "keywords": [
    "nextjs",
    "next",
    "proxy",
    "password",
    "gate",
    "demo",
    "vercel"
  ],
  "license": "MIT",
  "author": "Erwann Mest <m@kud.io>",
  "homepage": "https://github.com/kud/next-access-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/next-access-gate.git"
  },
  "bugs": {
    "url": "https://github.com/kud/next-access-gate/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p example/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:build": "npm run build && npm run build -w example",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
